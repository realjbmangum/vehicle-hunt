---
interface Props {
  size?: number;
  position?: "tl" | "tr" | "bl" | "br";
}
const { size = 28, position = "tr" } = Astro.props;
const map = { tl: "top:10px;left:10px", tr: "top:10px;right:10px", bl: "bottom:10px;left:10px", br: "bottom:10px;right:10px" };
---

<svg
  class="compass-corner"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  style={map[position]}
>
  <g stroke="var(--color-coyote)" stroke-opacity="0.55" stroke-width="0.75" fill="none">
    <circle cx="16" cy="16" r="10" />
    <circle cx="16" cy="16" r="13" stroke-dasharray="1 2" />
    <line x1="16" y1="2" x2="16" y2="6" />
    <line x1="16" y1="26" x2="16" y2="30" />
    <line x1="2" y1="16" x2="6" y2="16" />
    <line x1="26" y1="16" x2="30" y2="16" />
  </g>
  <polygon points="16,5 18,16 16,14 14,16" fill="var(--color-rust)" opacity="0.85" />
  <polygon points="16,27 14,16 16,18 18,16" fill="var(--color-coyote)" opacity="0.7" />
  <text
    x="16" y="18"
    text-anchor="middle"
    dominant-baseline="central"
    font-family="var(--font-mono)"
    font-size="5"
    fill="var(--color-coyote)"
    opacity="0.7"
  >N</text>
</svg>

<style>
  .compass-corner {
    position: absolute;
    pointer-events: none;
  }
</style>
