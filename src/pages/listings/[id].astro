    border: 1px solid color-mix(in oklch, var(--color-stop) 35%, var(--color-line));
    color: oklch(0.85 0.12 30);
    font-family: var(--font-display);
    font-stretch: 80%;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 2px;
