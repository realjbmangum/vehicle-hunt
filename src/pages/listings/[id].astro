  .danger-btn:hover { background: color-mix(in oklch, var(--color-stop) 28%, transparent); border-color: var(--color-stop); }

  @media (max-width: 1024px) {
    .detail-cols { grid-template-columns: 1fr; }
    .detail-side { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  }
  @media (max-width: 760px) {
    .dh-grid { grid-template-columns: 1fr; gap: 20px; }
    .dh-visual { max-width: 320px; }
    .dh-year { font-size: 3rem; }
    .dh-trim { font-size: 1.5rem; }
    .dh-stat-value { font-size: 1.75rem; }
    .detail-hero { padding: 22px 18px; }
    .detail-section { padding: 20px 18px; }
    .score-grid { flex-direction: column; align-items: stretch; }
  }
</style>

<script define:vars={{ listingId: id }}>
  const setStatus = (msg, kind) => {
    const el = document.getElementById("notes-status");
    if (!el) return;
    el.textContent = msg;
    el.classList.remove("is-saved", "is-error");
    if (kind) el.classList.add(kind);
  };

  document.querySelectorAll(".status-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const status = btn.getAttribute("data-status");
      document.querySelectorAll(".status-btn").forEach((b) => b.setAttribute("disabled", "true"));
      try {
        const res = await fetch(`/api/listings/${listingId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ status }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json().catch(() => ({}));
          alert("Failed to update status: " + (data.error || "Unknown error"));
        }
      } catch (err) {
        alert("Error updating status: " + err.message);
      } finally {
        document.querySelectorAll(".status-btn").forEach((b) => b.removeAttribute("disabled"));
      }
    });
  });

  document.getElementById("save-notes")?.addEventListener("click", async () => {
    const input = document.getElementById("notes-input");
    const notes = input ? input.value : "";
    setStatus("Saving…", null);
    try {
      const res = await fetch(`/api/listings/${listingId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ notes }),
      });
      if (res.ok) {
        setStatus("Saved", "is-saved");
        setTimeout(() => setStatus("", null), 2400);
      } else {
        setStatus("Save failed", "is-error");
      }
    } catch {
      setStatus("Network error", "is-error");
    }
  });

  document.getElementById("delete-listing")?.addEventListener("click", async () => {
    if (!confirm("Delete this listing? This cannot be undone.")) return;
    try {
      const res = await fetch(`/api/listings/${listingId}`, { method: "DELETE" });
      if (res.ok) {
        window.location.href = "/listings";
      } else {
        const data = await res.json().catch(() => ({}));
        alert("Failed to delete: " + (data.error || "Unknown error"));
      }
    } catch (err) {
      alert("Error deleting: " + err.message);
    }
  });
</script>
